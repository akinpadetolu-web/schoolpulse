{
  "name": "Grade Sync & Notifications",
  "description": "Automatically sync grades across all portals and send notifications when grades are created or updated",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Grade"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "grade_sync_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onGradeSubmitted",
            "args": {
              "gradeId": "{{event.entity_id}}",
              "schoolId": "{{data.schoolId}}",
              "studentId": "{{data.studentId}}",
              "teacherId": "{{data.teacherId}}",
              "subjectId": "{{data.subjectId}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onGradeSubmitted"
  }
}