{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "schoolId": {
      "type": "string"
    },
    "classId": {
      "type": "string"
    },
    "className": {
      "type": "string"
    },
    "subjectId": {
      "type": "string"
    },
    "subjectName": {
      "type": "string"
    },
    "teacherId": {
      "type": "string"
    },
    "teacherName": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "releaseDate": {
      "type": "string",
      "format": "date",
      "description": "Date the assignment becomes visible to students and parents. Empty means visible immediately."
    },
    "maxScore": {
      "type": "number",
      "default": 100
    },
    "attachmentFileUri": {
      "type": "string",
      "description": "Private storage URI of the document or image attached to this assignment. Only set after the file has passed content validation."
    },
    "attachmentFileName": {
      "type": "string",
      "description": "Original name of the attached document or image"
    },
    "attachmentMimeType": {
      "type": "string",
      "description": "Browser-reported MIME type of the attachment"
    },
    "term": {
      "type": "string",
      "description": "Academic term this assignment belongs to (e.g. Term 1, Midterm 2026)"
    },
    "isPublished": {
      "type": "boolean",
      "default": false
    },
    "isArchived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "schoolId",
    "title"
  ]
}